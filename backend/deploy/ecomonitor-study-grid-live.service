# Dati di rete per le app: intensita' attuale, previsione e ultime ore, per le zone
# che le app chiedono. Stesso utente e stessa chiave del raccoglitore giornaliero

[Unit]
Description=EcoMonitor grid data for the apps
Requires=postgresql.service
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ecomonitor_grid
Group=ecomonitor_grid
Environment=ECOMONITOR_STUDY_DSN=dbname=ecomonitor_study
LoadCredential=em_api_key:/etc/ecomonitor-study/em_api_key
ExecStart=/opt/ecomonitor-study/venv/bin/ecomonitor-study-grid --live
TimeoutStartSec=4min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
