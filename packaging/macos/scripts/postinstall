#!/bin/bash
# Eseguito da Installer come root dopo aver copiato CarbONara.app


set -u

APP="${2:-/Applications}/CarbONara.app"
[ -d "${APP}" ] || APP="${3:-}/Applications/CarbONara.app"
PERMISSIONS_SCRIPT="${APP}/Contents/Resources/install_powermetrics_permissions.sh"
#scritto da preinstall
RELAUNCH_LIST=/private/var/run/io.github.caponifederico.ecomonitor.relaunch
rm -f "${APP}/Contents/Resources/api_key"

#preinstall ha chiuso l'app
relaunch() {
    [ -f "${RELAUNCH_LIST}" ] || return 0
    local uid mode name
    while read -r uid mode; do
        name="$(id -un "${uid}" 2>/dev/null)" || continue
        #senza Dock quell'utente non ha piu' una sessione grafica aperta
        pgrep -u "${uid}" -x Dock >/dev/null 2>&1 || continue
        if [ "${mode}" = background ]; then
            launchctl asuser "${uid}" sudo -u "${name}" open -a "${APP}" --args --background
        else
            launchctl asuser "${uid}" sudo -u "${name}" open -a "${APP}"
        fi && echo "CarbO'Nara: riaperta per ${name}"
    done < <(sort -u "${RELAUNCH_LIST}")
    rm -f "${RELAUNCH_LIST}"
}
trap relaunch EXIT

APPLICATIONS="${APP%/*}"
APPLICATIONS="${APPLICATIONS/#\/\//\/}"
LEGACY_APP="${APPLICATIONS}/EcoMonitor.app"
LEGACY_EXECUTABLE="${LEGACY_APP}/Contents/MacOS/EcoMonitor"
NEW_EXECUTABLE="${APPLICATIONS}/CarbONara.app/Contents/MacOS/CarbONara"
if [ -x "${NEW_EXECUTABLE}" ]; then
    if [ -d "${LEGACY_APP}" ]; then
        rm -rf "${LEGACY_APP}" && echo "CarbO'Nara: rimossa la versione precedente ${LEGACY_APP}"
    fi
    rm -f "${APPLICATIONS}/EcoMonitorUninstall.command"
    for agent in /Users/*/Library/LaunchAgents/io.github.caponifederico.ecomonitor.plist; do
        [ -f "${agent}" ] && [ ! -L "${agent}" ] || continue
        [ "$(plutil -extract ProgramArguments.0 raw -o - "${agent}" 2>/dev/null)" = "${LEGACY_EXECUTABLE}" ] ||
            continue
        owner="$(stat -f %Su "${agent}")" || continue
        sudo -u "${owner}" plutil -replace ProgramArguments.0 -string "${NEW_EXECUTABLE}" "${agent}" &&
            echo "CarbO'Nara: avvio automatico aggiornato per ${owner}"
    done
fi

#La regola si aggiunge per chi installa: chi l'aveva gia' la conserva
TARGET_USER="${USER:-}"
if [ -z "${TARGET_USER}" ] || [ "${TARGET_USER}" = root ]; then
    TARGET_USER="$(stat -f %Su /dev/console 2>/dev/null || true)"
fi

#in caso di errore
give_up() {
    echo "CarbO'Nara: autorizzazione a powermetrics NON installata: $*" >&2
    echo "CarbO'Nara: l'app misurera' per stima. Per rimediare:" >&2
    echo "  sudo bash \"${PERMISSIONS_SCRIPT}\"" >&2
    exit 0
}

[ -f "${PERMISSIONS_SCRIPT}" ] || give_up "manca ${PERMISSIONS_SCRIPT}"
[ -n "${TARGET_USER}" ] || give_up "utente di destinazione non determinabile"
[ "${TARGET_USER}" != root ] || give_up "installazione fatta da root, nessun utente a cui concederla"

case "${TARGET_USER}" in
*[!A-Za-z0-9._-]*) give_up "nome utente '${TARGET_USER}' non adatto a una regola sudoers" ;;
esac

echo "CarbO'Nara: autorizzo powermetrics per l'utente ${TARGET_USER}"
if bash "${PERMISSIONS_SCRIPT}" --user "${TARGET_USER}"; then
    echo "CarbO'Nara: autorizzazione installata, la misura sara' nativa"
else
    give_up "lo script e' uscito con ${?}"
fi

exit 0
